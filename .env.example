# ═══════════════════════════════════════════════════════════════════════════
# EcoPackAI — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# --- Application ---
APP_ENV=development
LOG_LEVEL=info
API_RATE_LIMIT=100

# --- Database ---
DATABASE_URL=postgresql://ecopack:ecopack_secret@postgres:5432/ecopackai
POSTGRES_USER=ecopack
POSTGRES_PASSWORD=ecopack_secret
POSTGRES_DB=ecopackai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Model Paths ---
MODEL_PATH=./models
CLASSIFIER_MODEL=best_model.joblib
PPO_MODEL=ppo_packing_v1.zip

# --- Feature Flags (JSON) ---
FEATURE_FLAGS={"enable_rl_packing": false, "enable_ab_testing": true, "enable_prometheus": true}

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ecopack_grafana

# --- Prometheus ---
PROMETHEUS_RETENTION=15d

# --- Security & Auth (Phase 8/11) ---
CORS_ORIGINS=http://localhost,http://localhost:5173
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Frontend ---
VITE_API_URL=http://localhost:8000
